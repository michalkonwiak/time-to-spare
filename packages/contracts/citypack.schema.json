{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "synthetic",
          "default": "synthetic",
          "title": "Kind",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "verified_at",
        "valid_until"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PackPlace": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "categories": {
          "default": [],
          "items": {
            "enum": [
              "walk",
              "food",
              "art"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "cost_upper_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Upper Minor"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Free"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "visit_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 10800,
          "title": "Visit Seconds",
          "type": "integer"
        },
        "windows": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Window"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Windows"
        }
      },
      "required": [
        "id",
        "name",
        "visit_seconds",
        "cost_upper_minor",
        "windows",
        "evidence_ids",
        "valid_until"
      ],
      "title": "PackPlace",
      "type": "object"
    },
    "PackRoute": {
      "additionalProperties": false,
      "properties": {
        "base_seconds": {
          "minimum": 0,
          "title": "Base Seconds",
          "type": "integer"
        },
        "destination": {
          "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
          "title": "Destination",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "origin": {
          "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
          "title": "Origin",
          "type": "string"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Free"
        }
      },
      "required": [
        "origin",
        "destination",
        "base_seconds",
        "evidence_id"
      ],
      "title": "PackRoute",
      "type": "object"
    },
    "ReturnPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ReturnPoint",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "closes_at": {
          "format": "date-time",
          "title": "Closes At",
          "type": "string"
        },
        "last_admission": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Admission"
        },
        "opens_at": {
          "format": "date-time",
          "title": "Opens At",
          "type": "string"
        }
      },
      "required": [
        "opens_at",
        "closes_at"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "currency": {
      "const": "PLN",
      "title": "Currency",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "fixture_clock": {
      "format": "date-time",
      "title": "Fixture Clock",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9:_-]{0,99}$",
      "title": "Id",
      "type": "string"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/PackPlace"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Places",
      "type": "array"
    },
    "return_point": {
      "$ref": "#/$defs/ReturnPoint"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/PackRoute"
      },
      "maxItems": 441,
      "title": "Routes",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "synthetic",
    "timezone",
    "currency",
    "fixture_clock",
    "valid_until",
    "return_point",
    "evidence",
    "places",
    "routes"
  ],
  "title": "CityPack",
  "type": "object"
}
